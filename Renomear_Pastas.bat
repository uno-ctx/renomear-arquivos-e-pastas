@echo off
chcp 65001 >nul
setlocal DisableDelayedExpansion
title Renomear pastas e arquivos - V3 PORTUGUES E INGLES
set "RENOMEADOR_BAT=%~f0"
cd /d "%SystemRoot%"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "try { $ErrorActionPreference = 'Stop'; $texto = [IO.File]::ReadAllText($env:RENOMEADOR_BAT, [Text.Encoding]::UTF8); $marca = '# INICIO_' + 'POWERSHELL'; $indice = $texto.LastIndexOf($marca); if ($indice -lt 0) { throw 'Bloco PowerShell nao encontrado. Baixe o BAT completo.' }; & ([scriptblock]::Create($texto.Substring($indice + $marca.Length))); exit 0 } catch { Write-Host ('ERRO: ' + $_.Exception.Message) -ForegroundColor Red; exit 1 }"
if errorlevel 1 (
    echo.
    echo Falha na execucao. Confira a mensagem acima.
    pause
)
exit /b
# INICIO_POWERSHELL
$ErrorActionPreference = 'Stop'
function Pausar { [void](Read-Host 'Pressione ENTER para continuar') }
function LerTexto($mensagem) { return (Read-Host $mensagem) }
